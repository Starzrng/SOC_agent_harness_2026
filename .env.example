# Copy to .env and fill in your values. Never commit .env.

# Competition runtime. Take the address and the key from the competition site.
SCENARIO_RUNTIME_ENDPOINT=bluesec.team:443
SCENARIO_RUNTIME_TOKEN=replace-with-your-key
SCENARIO_RUNTIME_VERIFY_TLS=true
# Optional: choose a specific competition arena instead of the currently open default.
# SCENARIO_RUNTIME_ARENA=practice

GRPC_DNS_RESOLVER=native
REMOTE_RUN_LABEL=my-agent
# Shown next to your runs in the competition interface.
AGENT_NAME=my-agent

# OpenAI-compatible LLM provider. All three are required.
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_DEFAULT_MODEL=provider/model-name

# Optional limits.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_COMPLETION_TOKENS=16384
LLM_MAX_STEP_RETRIES=3
BLUESEC_AGENT_MAX_STEPS=100

# --- Agent harness (tools mode is the guarded native tool-calling agent) ---
# AGENT_MODE=tools                # tools | sgr (sgr = original reference agent)
# LLM_TOOL_CHOICE=required        # required | auto (use auto if the provider rejects "required")
# LLM_PARALLEL_TOOL_CALLS=true    # omit if the provider rejects the parameter
# LLM_TEMPERATURE=0               # omit for reasoning models that reject temperature
# LLM_EXTRA_BODY={"reasoning":{"effort":"medium"}}   # provider-specific JSON passthrough
# BLUESEC_AGENT_SOFT_BUDGET=16    # runtime calls after which the model is told to finish
# BLUESEC_AGENT_HARD_BUDGET=20    # runtime calls after which only finish_investigation is allowed
# BLUESEC_AGENT_MAX_PARALLEL_CALLS=4
# BLUESEC_AGENT_CONCURRENCY=1     # tasks investigated in parallel (runtime may refuse >1)
# BLUESEC_TRANSCRIPT_DIR=runs     # JSONL traces; empty to disable. Keep private.
# BLUESEC_TOOL_DENYLIST=          # comma-separated advertised tools the agent must never call
# BLUESEC_PROMPT_FILE=            # alternative system prompt file for experiments

# --- Jev shadow evaluation (scripts/jev_shadow.py; never influences a run) ---
# Sends recorded traces to the TypeSafe API: keep in mind the competition's data rules.
# TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest            # or a pinned version, e.g. jev-1.13.0
# JEV_TIMEOUT_SECONDS=10
